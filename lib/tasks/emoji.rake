namespace :emoji do
  desc "Regenerate vendor/javascript/emoji-data.js from emojibase-data (VERSION=x.y.z to change the release)"
  task :update do
    require "net/http"

    version = ENV.fetch("VERSION", "18.0.0")
    fetch = ->(path) do
      response = Net::HTTP.get_response(URI("https://cdn.jsdelivr.net/npm/emojibase-data@#{version}/#{path}"))
      response.value # Raises unless the request succeeded
      JSON.parse(response.body)
    end

    emoji = fetch.("en/data.json")
    groups = fetch.("en/messages.json")["groups"].reject { it["key"] == "component" }
    shortcodes = fetch.("en/shortcodes/cldr.json").merge(fetch.("en/shortcodes/github.json"))

    # The composer matches and renders shortcodes as plain text, so keep them to these characters
    valid_shortcode = /\A[a-z0-9_+\-]+\z/

    lines = groups.sort_by { it["order"] }.flat_map do |group|
      members = emoji.select { it["group"] == group["order"] }.sort_by { it["order"] }
      rows = members.map do |entry|
        codes = Array(shortcodes[entry["hexcode"]]).grep(valid_shortcode)
        [ entry["emoji"], entry["label"], codes.join(" "), Array(entry["tags"]).join(" "), entry["version"] ]
      end

      [ "  { name: #{JSON.generate(group["message"].capitalize)}, emoji: [" ] +
        rows.map { "    #{JSON.generate(it)}," } +
        [ "  ] }," ]
    end

    File.write Rails.root.join("vendor/javascript/emoji-data.js"), <<~JS
      // Generated by `bin/rails emoji:update` from emojibase-data #{version}. Do not edit by hand.
      // https://github.com/milesj/emojibase, MIT License, Copyright (c) 2017-2019 Miles Johnson.
      // Emoji names and keywords come from the Unicode CLDR project, Unicode License v3.
      //
      // Each emoji is [ character, name, shortcodes, keywords, emoji version ].
      export default [
      #{lines.join("\n")}
      ]
    JS
  end
end
